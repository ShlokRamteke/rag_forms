# Database & AI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/rag_forms?retryWrites=true&w=majority
GEMINI_API_KEY=your_actual_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
PORT=5001

# Clerk Authentication (Get from https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# AES-256-GCM Data Encryption (Required in production: 32+ character random string)
APP_DATA_KEY=generate_a_random_32_character_secret_key_here

# Optional: MongoDB Vector Search index name (if using Atlas Vector Search)
MONGO_VECTOR_SEARCH_INDEX=vector_index

# Optional: CORS allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Optional: Render keep-alive (Auto-configured on Render.com)
RENDER_EXTERNAL_URL=https://your-app.onrender.com
