# Backend API Server URL (Use http://localhost:5001 for local dev, or your production URL like https://your-app.onrender.com)
VITE_APP_API_URL=http://localhost:5001

# Auth0 Authentication (Get from https://manage.auth0.com -> Applications)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_client_id_here
# Optional/Recommended API Audience (Get from https://manage.auth0.com -> Applications -> APIs)
VITE_AUTH0_AUDIENCE=https://api.cipherforms.com

# Optional: Google Analytics / Tag Manager Measurement ID
VITE_GTAG_ID=G-XXXXXXXXXX

# Optional: Microsoft Clarity Project ID
VITE_CLARITY_ID=your_clarity_project_id_here
